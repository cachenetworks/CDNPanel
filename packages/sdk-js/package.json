{
  "name": "@cachenetworks/cdnpanel-sdk",
  "version": "2.0.0",
  "description": "Official TypeScript / JavaScript SDK for the CDNPanel API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
