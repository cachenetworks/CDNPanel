// CDN platform database schema.
// IDs are prefixed ULIDs generated by the application (see @cdn/shared ids.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Staff, RBAC ────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id                    String     @id
  email                 String     @unique
  name                  String
  /// Argon2id hash. Null until an invited user accepts their invitation.
  passwordHash          String?
  status                UserStatus @default(ACTIVE)
  /// AES-256-GCM encrypted TOTP secret (enc.v1 format).
  totpSecretEnc         String?
  totpEnabled           Boolean    @default(false)
  requireTwoFactor      Boolean    @default(false)
  lastLoginAt           DateTime?
  lastLoginIp           String?
  passwordChangedAt     DateTime?
  createdById           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  roles          UserRole[]
  sessions       Session[]
  recoveryCodes  RecoveryCode[]
  tokens         UserToken[]
  apiKeys        ApiKey[]       @relation("ApiKeyCreator")
  files          File[]         @relation("FileUploader")
  folders        Folder[]       @relation("FolderCreator")
  uploads        Upload[]
  auditLogs      AuditLog[]

  @@index([status])
}

model Role {
  id          String           @id
  name        String           @unique
  description String           @default("")
  system      Boolean          @default(false)
  locked      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id             String    @id
  userId         String
  /// SHA-256 of the session token. The raw token only lives in the user's cookie.
  tokenHash      String    @unique
  ip             String?
  userAgent      String?
  rememberMe     Boolean   @default(false)
  /// Set when the user completed 2FA (or 2FA is not enabled).
  mfaVerified    Boolean   @default(true)
  /// Last successful password re-authentication, for step-up protected actions.
  reauthAt       DateTime?
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RecoveryCode {
  id        String    @id
  userId    String
  /// SHA-256 of the recovery code.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
}

/// One-time invitation / password-reset tokens (only the hash is stored).
model UserToken {
  id        String        @id
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─── API keys ───────────────────────────────────────────────────────────────

enum ApiKeyEnvironment {
  LIVE
  TEST
}

model ApiKey {
  id               String            @id
  name             String
  /// Non-secret identifying prefix, e.g. cdn_live_a82f
  prefix           String
  /// HMAC-SHA256(derived key, full api key). The raw key is NEVER stored.
  keyHash          String            @unique
  /// Master key version used to derive the HMAC key (supports key rotation).
  hashVersion      Int
  environment      ApiKeyEnvironment @default(LIVE)
  createdById      String?
  enabled          Boolean           @default(true)
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedReason    String?
  /// Requests per minute; null = use the default from settings.
  rateLimit        Int?
  /// CIDR or IP allowlist; empty = any.
  ipRestrictions   String[]          @default([])
  /// Endpoint allowlist patterns such as "GET /api/v1/files*"; empty = any.
  allowedEndpoints String[]          @default([])
  /// Optional AES-256-GCM encrypted free-form notes (may contain sensitive info).
  notesEnc         String?
  lastUsedAt       DateTime?
  lastUsedIp       String?
  requestCount     BigInt            @default(0)
  rotatedFromId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  createdBy   User?          @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  scopes      ApiKeyScope[]
  requests    FileRequest[]
  uploads     Upload[]
  files       File[]         @relation("FileApiKey")

  @@index([prefix])
  @@index([enabled, revokedAt])
}

model ApiKeyScope {
  apiKeyId String
  scope    String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, scope])
}

// ─── Storage, files, folders ────────────────────────────────────────────────

enum StorageKind {
  LOCAL
  S3
  R2
  MINIO
  B2
}

model StorageProvider {
  id          String      @id
  name        String      @unique
  kind        StorageKind
  /// AES-256-GCM encrypted JSON configuration (credentials included). AAD = provider id.
  configEnc   String
  /// Non-sensitive summary for display (bucket, endpoint, path).
  publicInfo  Json        @default("{}")
  isDefault   Boolean     @default(false)
  enabled     Boolean     @default(true)
  /// Optional soft capacity in bytes for capacity dashboards / quotas.
  capacity    BigInt?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  files       File[]
  uploads     Upload[]
}

enum Visibility {
  PUBLIC
  PRIVATE
  AUTHENTICATED
  SIGNED_URL_ONLY
}

enum FileStatus {
  UPLOADING
  PROCESSING
  SCANNING
  READY
  QUARANTINED
  FAILED
}

model Folder {
  id           String      @id
  name         String
  /// URL slug used for friendly paths
  slug         String
  parentId     String?
  /// Materialised slug path, e.g. "/images/icons" (used for friendly URLs and subtree queries).
  path         String      @unique
  /// Folder default visibility for new files; null = inherit
  visibility   Visibility?
  /// Folder-level permission override: if set, staff need this permission in addition (e.g. "files.download").
  restrictedToRoleIds String[] @default([])
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Folder[] @relation("FolderTree")
  files     File[]
  createdBy User?    @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([parentId, slug])
}

model File {
  id                 String       @id
  name               String
  /// URL slug for friendly paths, unique per folder
  slug               String
  folderId           String?
  mimeType           String
  /// Extension from the normalised name (informational only)
  extension          String       @default("")
  size               BigInt
  sha256             String?
  storageProviderId  String
  storageKey         String
  visibility         Visibility   @default(PRIVATE)
  status             FileStatus   @default(UPLOADING)
  statusReason       String?
  /// Explicit Cache-Control override; null = settings default
  cacheControl       String?
  /// Always serve with Content-Disposition: attachment
  forceDownload      Boolean      @default(false)
  width              Int?
  height             Int?
  durationSeconds    Float?
  /// Custom metadata (metadata:write scope)
  metadata           Json         @default("{}")
  uploadedById       String?
  uploadedByApiKeyId String?
  downloadCount      BigInt       @default(0)
  bandwidthBytes     BigInt       @default(0)
  lastAccessedAt     DateTime?
  scannedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  folder           Folder?         @relation(fields: [folderId], references: [id], onDelete: Restrict)
  storageProvider  StorageProvider @relation(fields: [storageProviderId], references: [id], onDelete: Restrict)
  uploadedBy       User?           @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByApiKey ApiKey?         @relation("FileApiKey", fields: [uploadedByApiKeyId], references: [id], onDelete: SetNull)
  requests         FileRequest[]

  @@index([folderId, createdAt])
  @@index([folderId, slug])
  @@index([sha256])
  @@index([status])
  @@index([mimeType])
  @@index([uploadedById])
  @@index([createdAt])
}

enum UploadStatus {
  PENDING
  COMPLETING
  COMPLETED
  FAILED
  ABORTED
  EXPIRED
}

/// Chunked / resumable upload session.
model Upload {
  id                String          @id
  filename          String
  mimeType          String?
  totalSize         BigInt
  chunkSize         Int
  totalChunks       Int
  receivedChunks    Int[]           @default([])
  receivedBytes     BigInt          @default(0)
  expectedSha256    String?
  folderId          String?
  visibility        Visibility?
  storageProviderId String
  status            UploadStatus    @default(PENDING)
  error             String?
  fileId            String?
  userId            String?
  apiKeyId          String?
  expiresAt         DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  storageProvider StorageProvider @relation(fields: [storageProviderId], references: [id], onDelete: Restrict)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?         @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
}

// ─── Analytics ──────────────────────────────────────────────────────────────

/// Raw delivery/API request log (pruned according to the retention setting).
model FileRequest {
  id           BigInt   @id @default(autoincrement())
  timestamp    DateTime @default(now())
  fileId       String?
  folderId     String?
  apiKeyId     String?
  method       String
  route        String
  statusCode   Int
  bytesSent    BigInt   @default(0)
  responseMs   Int
  mimeType     String?
  country      String?
  /// Truncated / anonymised according to privacy settings
  ip           String?
  userAgent    String?
  /// "delivery" for CDN file serving, "api" for REST API calls
  kind         String   @default("delivery")
  cacheStatus  String?

  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([fileId, timestamp])
  @@index([apiKeyId, timestamp])
  @@index([kind, timestamp])
  @@index([statusCode, timestamp])
}

/// Daily rollups, retained long after raw FileRequest rows are pruned.
model AnalyticsDaily {
  id          String   @id
  date        DateTime @db.Date
  /// "total" | "file" | "api_key" | "mime" | "country" | "status"
  dimension   String
  dimensionId String   @default("")
  requests    BigInt   @default(0)
  downloads   BigInt   @default(0)
  bytes       BigInt   @default(0)
  errors      BigInt   @default(0)
  uploads     BigInt   @default(0)
  avgMs       Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([date, dimension, dimensionId])
  @@index([dimension, date])
}

// ─── Audit & security ───────────────────────────────────────────────────────

/// Append-only audit trail. A database trigger (see migration) blocks UPDATE and DELETE
/// except for retention pruning executed with the cdn.audit_prune session flag.
model AuditLog {
  id         String   @id
  timestamp  DateTime @default(now())
  actorId    String?
  actorType  String   @default("user")
  actorLabel String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json     @default("{}")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([action, timestamp])
  @@index([actorId, timestamp])
  @@index([targetType, targetId])
}

model SecurityEvent {
  id        String   @id
  timestamp DateTime @default(now())
  /// LOGIN_FAILED | RATE_LIMITED | INVALID_API_KEY | API_KEY_IP_BLOCKED | CSRF_FAILED | SIGNED_URL_INVALID | ACCOUNT_LOCKED ...
  type      String
  severity  String   @default("info")
  ip        String?
  userId    String?
  apiKeyId  String?
  userAgent String?
  details   Json     @default("{}")

  @@index([type, timestamp])
  @@index([timestamp])
  @@index([ip])
}

// ─── Settings & webhooks ────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Webhook {
  id          String            @id
  name        String
  url         String
  /// AES-256-GCM encrypted signing secret (must be reversible to sign payloads).
  secretEnc   String
  events      String[]
  enabled     Boolean           @default(true)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookDelivery {
  id            String                @id
  webhookId     String
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  responseBody  String?
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  webhook       Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status])
}
