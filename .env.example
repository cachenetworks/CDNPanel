# ─────────────────────────────────────────────────────────────────────────────
# CDN platform configuration. Copy to `.env` and fill in every value marked REQUIRED.
# Never commit `.env`. Generate secrets with the commands shown.
# The application refuses to start if security-critical values are missing or weak.
# ─────────────────────────────────────────────────────────────────────────────

# Public URLs (no trailing slash). Single-domain example — everything on one host:
APP_URL=https://cdn.example.com
CDN_URL=https://cdn.example.com
API_URL=https://cdn.example.com
# Split-domain alternative: APP_URL=https://panel.example.com CDN_URL=https://cdn.example.com API_URL=https://api.example.com
# Extra browser origins allowed to call the API with bearer keys (comma separated):
CORS_ORIGINS=

# Host port Nginx listens on (docker compose)
HTTP_PORT=8873

# Database / cache — REQUIRED (docker compose builds DATABASE_URL / REDIS_URL from these)
POSTGRES_USER=cdn
POSTGRES_DB=cdn
POSTGRES_PASSWORD=            # openssl rand -base64 24
REDIS_PASSWORD=               # openssl rand -hex 24
# For running outside docker compose:
DATABASE_URL=postgresql://cdn:password@127.0.0.1:5432/cdn
REDIS_URL=redis://127.0.0.1:6379/0

# Secrets — REQUIRED
SESSION_SECRET=               # openssl rand -base64 48
MASTER_ENCRYPTION_KEY=        # openssl rand -base64 32   (32 bytes, base64). Back it up separately!
MASTER_ENCRYPTION_KEY_VERSION=1
# After rotating: retired keys as "version:base64key,version:base64key"
MASTER_ENCRYPTION_KEYS_PREVIOUS=

# Storage: LOCAL | S3 | R2 | MINIO | B2
STORAGE_DRIVER=LOCAL
LOCAL_STORAGE_PATH=./data/storage
UPLOAD_TMP_PATH=./data/tmp
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Proxy trust. "false", a hop count, or comma-separated proxy IPs/CIDRs. Never "true" in production.
TRUST_PROXY=false
# Read CF-Connecting-IP / CF-IPCountry (only honoured from trusted proxies). Enable behind Cloudflare.
TRUST_CLOUDFLARE_HEADERS=false

MAX_UPLOAD_SIZE=5GB
# stream | x-accel (local storage behind Nginx) | redirect (S3 presigned URLs)
DELIVERY_MODE=stream

# Optional malware scanning (docker compose --profile clamav): CLAMAV_HOST=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310

WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
LOG_LEVEL=info

# Container images (docker compose pull). Pin a version tag or sha to avoid surprise upgrades.
# API_IMAGE=ghcr.io/cachenetworks/cdnpanel-api:latest
# WEB_IMAGE=ghcr.io/cachenetworks/cdnpanel-web:latest

# ─── 2.0: zones, custom domains, edge, observability (all optional) ─────────
# Dashboard hostname. Every other Host reaching nginx is served as a zone custom domain
# (zone-relative paths such as https://assets.example.com/logo.png). Empty disables that routing.
PANEL_HOST=
# Hostname custom domains should CNAME to (default: the CDN_URL host).
DOMAIN_CNAME_TARGET=
# Development only: mark custom domains verified without DNS / HTTPS checks.
DOMAIN_VERIFICATION_DISABLED=false
# Cloudflare API token (Zone → Cache Purge: Purge, Zone → Analytics: Read) for edge purges and
# HIT/MISS statistics. Zones can also carry their own token (stored encrypted).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Request header carrying the client ASN set by a trusted proxy (enables ASN blocking), e.g. X-ASN.
ASN_HEADER=
# FFmpeg binaries for the media pipeline (included in the API image).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Bearer token for GET /metrics. Empty: /metrics answers only private-network clients.
METRICS_TOKEN=
# OTLP/HTTP traces endpoint, e.g. http://otel-collector:4318/v1/traces. Empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
