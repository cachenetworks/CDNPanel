{
  "name": "@cdn/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --watch-path=src --import tsx src/server.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --watch-path=src --import tsx src/worker/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker/index.js",
    "create-admin": "node --env-file-if-exists=../../.env dist/scripts/create-admin.js",
    "openapi": "node --env-file-if-exists=../../.env dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@cdn/database": "*",
    "@cdn/shared": "*",
    "@cdn/storage": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.21.0",
    "file-type": "^19.6.0",
    "image-size": "^1.1.1",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.2.0",
    "music-metadata": "^10.5.0",
    "otplib": "^12.0.1",
    "fastify": "^5.0.0",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.1"
  }
}
