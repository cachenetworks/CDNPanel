{
  "name": "@cdn/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --watch-path=src --import tsx src/server.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --watch-path=src --import tsx src/worker/index.ts",
    "start": "node --env-file-if-exists=../../.env --import ./dist/otel.js dist/server.js",
    "start:worker": "node --env-file-if-exists=../../.env --import ./dist/otel.js dist/worker/index.js",
    "create-admin": "node --env-file-if-exists=../../.env dist/scripts/create-admin.js",
    "openapi": "node --env-file-if-exists=../../.env dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@cdn/database": "*",
    "@cdn/shared": "*",
    "@cdn/storage": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prometheus-io/client": "^0.16.1",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.21.0",
    "fastify": "^5.0.0",
    "file-type": "^19.6.0",
    "image-size": "^2.0.4",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.2.0",
    "music-metadata": "^12.0.0",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.1"
  }
}
