# Shared secret the main CDN server uses to talk to this node. REQUIRED, 32+ characters.
#   openssl rand -base64 48
NODE_TOKEN=

# Label shown in the panel (defaults to the container hostname).
NODE_NAME=

# Where shards are stored on this server (the disk you want to add to the CDN).
# The agent runs as uid 1000: mkdir -p data && sudo chown 1000:1000 data
NODE_DATA_DIR=./data

# Listen address/port. Prefer a private address, e.g. your Tailscale IP.
NODE_BIND=0.0.0.0
NODE_PORT=8874
