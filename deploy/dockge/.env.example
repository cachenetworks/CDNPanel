# Dockge .env for the CDNPanel stack. Generate each secret with the command shown.
APP_URL=https://cdn.cachedev.live
CDN_URL=https://cdn.cachedev.live
API_URL=https://cdn.cachedev.live
HTTP_PORT=8873

POSTGRES_PASSWORD=          # openssl rand -hex 24
REDIS_PASSWORD=             # openssl rand -hex 24
SESSION_SECRET=             # openssl rand -base64 48
MASTER_ENCRYPTION_KEY=      # openssl rand -base64 32   — back this up!
MASTER_ENCRYPTION_KEY_VERSION=1

STORAGE_DRIVER=LOCAL
TRUST_CLOUDFLARE_HEADERS=true
# stream (default) or x-accel (Nginx serves local files directly)
DELIVERY_MODE=stream
MAX_UPLOAD_SIZE=5GB

# Pin a specific build instead of :latest, e.g. ghcr.io/cachenetworks/cdnpanel-api:sha-abc1234
# API_IMAGE=
# WEB_IMAGE=
